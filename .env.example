# Local development values only. Real secrets are never committed:
# this file stays empty for secrets and is copied to .env (gitignored).

# --- API (read by apps/api, and docker compose interpolates from the root .env) ---
# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=4000
# PostgreSQL URL. Local default points at the docker-compose postgres
# (lulu/lulu_dev_password); replace with your Neon URL if you use one.
DATABASE_URL=postgresql://lulu:lulu_dev_password@localhost:5432/lulu
# Redis URL. Local default points at the docker-compose redis; Upstash uses rediss://
REDIS_URL=redis://localhost:6379
# Browser origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
# Token signing secret: required in production (32+ characters). Empty locally uses a dev fallback.
JWT_SECRET=
# How long a login token stays valid (examples: 1h, 7d)
AUTH_TOKEN_TTL=1h
# bcrypt cost for password hashing (4-15; lower is faster and weaker)
PASSWORD_HASH_ROUNDS=10
# Passwords for the seeded demo users; empty uses the built-in dev defaults (never real accounts)
SEED_OWNER_PASSWORD=
SEED_MEMBER_PASSWORD=
# AI provider: simulated needs no key; any other value requires AI_API_KEY
AI_PROVIDER=simulated
# Key for the real AI provider: leave empty to use the simulated provider
AI_API_KEY=
# The docker entrypoint runs the (idempotent) seed when true
SEED_ON_START=true

# --- Web only ---
# Port of the API when the web app calls it
API_PORT=
# Public URLs of the web app and API
WEB_URL=
API_URL=
# Mock mode for the web app: true uses sample data, false calls the real API for everything
NEXT_PUBLIC_USE_MOCK=true
# With mock mode on, these areas use the real API anyway (comma-separated). Switch linked areas together:
# me,users | contacts,companies | pipelines,deals | tasks,notes,activities. Others: overview, segments,
# imports, settings, ai. Example: NEXT_PUBLIC_REAL_API=me,users,contacts,companies
NEXT_PUBLIC_REAL_API=
# Base URL of the API for the browser, for example http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=
