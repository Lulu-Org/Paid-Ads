# Local development values only. Real secrets are never committed:
# this file stays empty for secrets and is copied to .env (gitignored).

# --- API (read by apps/api, and docker compose interpolates from the root .env) ---
# development | test | production
NODE_ENV=development
# Port the API listens on
PORT=4000
# Ports docker compose publishes on your machine. Change them if something else already
# uses them, and keep DATABASE_URL / REDIS_URL below on the same ports.
POSTGRES_PORT=5433
REDIS_PORT=6379
# PostgreSQL URL. Local default points at the docker-compose postgres on POSTGRES_PORT
# (lulu/lulu_dev_password); use your own host/port for a local install, or your Neon URL.
DATABASE_URL=postgresql://lulu:lulu_dev_password@localhost:5433/lulu
# Redis URL. Local default points at the docker-compose redis on REDIS_PORT; Upstash uses rediss://
REDIS_URL=redis://localhost:6379
# Browser origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
# Token signing secret: required in production (32+ characters). Empty locally uses a dev fallback.
JWT_SECRET=
# How long a login token stays valid (examples: 1h, 7d)
AUTH_TOKEN_TTL=1h
# bcrypt cost for password hashing (4-15; lower is faster and weaker)
PASSWORD_HASH_ROUNDS=10
# Passwords for the seeded demo users; empty uses the built-in dev defaults (never real accounts)
SEED_OWNER_PASSWORD=
SEED_MEMBER_PASSWORD=
# AI provider: simulated needs no key; any other value requires AI_API_KEY
AI_PROVIDER=simulated
# Key for the real AI provider: leave empty to use the simulated provider
AI_API_KEY=
# Ad platform provider per platform: simulated | live. Google LSA (C1), Google Ads (C2)
# and LinkedIn (C4) are live-capable; live fails fast for Meta until C3.
ADS_PROVIDER_GOOGLE_LSA=simulated
ADS_PROVIDER_GOOGLE_ADS=simulated
ADS_PROVIDER_META_ADS=simulated
ADS_PROVIDER_LINKEDIN_ADS=simulated
# AES-256-GCM key for ad-account tokens: required in production (32+ characters).
# Empty outside production uses a dev fallback.
ADS_TOKEN_ENCRYPTION_KEY=
# Google Ads API credentials shared by the live Google LSA and Google Ads connectors.
# Required when ADS_PROVIDER_GOOGLE_LSA=live or ADS_PROVIDER_GOOGLE_ADS=live.
# The developer token comes from the Google Ads API Center.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional manager account id sent as login-customer-id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Google Ads API version (v26 is the C1/C2 target)
GOOGLE_ADS_API_VERSION=v26
# Public base URL of the API, used for the OAuth callback. Defaults to http://localhost:PORT
API_PUBLIC_URL=http://localhost:4000
# LinkedIn Marketing API app (needed only with ADS_PROVIDER_LINKEDIN_ADS=live). Version = YYYYMM.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
# The docker entrypoint runs the (idempotent) seed when true
SEED_ON_START=true

# --- Web only ---
# Port of the API when the web app calls it
API_PORT=
# Public URLs of the web app and API
WEB_URL=
API_URL=
# Mock mode for the web app: true uses sample data, false calls the real API for everything
NEXT_PUBLIC_USE_MOCK=true
# With mock mode on, these areas use the real API anyway (comma-separated). Switch linked areas together:
# me,users | contacts,companies | pipelines,deals | tasks,notes,activities. Others: overview, segments,
# imports, settings, ai. Example: NEXT_PUBLIC_REAL_API=me,users,contacts,companies
NEXT_PUBLIC_REAL_API=
# Base URL of the API for the browser, for example http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=

# Meta Ads app (needed only with ADS_PROVIDER_META_ADS=live). From the Meta for Developers app dashboard.
META_APP_ID=
META_APP_SECRET=
# Marketing API version; Meta retires versions about every 90 days after a newer one ships
META_API_VERSION=v26.0